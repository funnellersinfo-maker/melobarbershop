// MELO BARBERSHOP - Modelo operativo y financiero
// Dinero en COP enteros (sin decimales). Tiempos en DateTime UTC.
// Estados de cita: RESERVED | CONFIRMED | IN_ATTENTION | COMPLETED | CANCELLED | NO_SHOW

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =========================================================== USUARIOS / SESIONES
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  passwordHash  String
  role          String   @default("BARBER") // OWNER | BARBER
  active        Boolean  @default(true)
  // Permisos excepcionales del barbero, validados SIEMPRE en el servidor:
  // { "finance.viewOthers": bool, "schedule.manageOwn": bool, "settlements.approveOwn": bool }
  permissions     String  @default("{}")
  notifyInternal  Boolean @default(true)
  notifyWhatsapp  Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions             Session[]
  barberServices       BarberService[]
  availability         Availability[]
  commissionRules      CommissionRule[]       @relation("RuleForBarber")
  commissionsBarber    Commission[]           @relation("CommissionBarber")
  adjustmentsBarber     CommissionAdjustment[] @relation("AdjustmentBarber")
  settlementsBarber    Settlement[]           @relation("SettlementBarber")
  settlementsApproved  Settlement[]           @relation("SettlementApprover")
  adjustmentsCreated   CommissionAdjustment[] @relation("AdjustmentCreator")
  expensesCreated      Expense[]              @relation("ExpenseCreator")
  paymentsRegistered   Payment[]              @relation("PaymentRegistrar")
  auditLogs            AuditLog[]
  notifications        Notification[]
  appointmentsAsBarber Appointment[]           @relation("AppointmentBarber")
  appointmentsCreated  Appointment[]           @relation("AppointmentCreator")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// =========================================================== CATÁLOGO / AUTORIZACIONES
model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int // COP (precio vigente al momento; las citas guardan su propia copia)
  durationMin Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments   Appointment[]
  barberServices BarberService[]
  commissionRules CommissionRule[]
}

// Servicios autorizados por barbero (control de oferta, independiente de la economía)
model BarberService {
  id         String   @id @default(cuid())
  barberId   String
  serviceId  String
  authorized Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  barber     User    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
}

// Ventana semanal de disponibilidad de un barbero
model Availability {
  id        String  @id @default(cuid())
  barberId  String
  dayOfWeek Int // 0=domingo ... 6=sábado
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  active    Boolean @default(true)
  barber    User    @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
}

// =========================================================== REGLAS DE COMISIÓN (versionadas)
// serviceId=null => regla por defecto del barbero (aplica a sus servicios sin regla específica)
model CommissionRule {
  id             String    @id @default(cuid())
  barberId       String
  serviceId      String?
  commissionType String // PERCENT | FIXED | MIXED
  percent        Float? // 0-100 (% sobre venta neta)
  fixedAmount    Int? // COP por servicio
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  barber         User     @relation("RuleForBarber", fields: [barberId], references: [id], onDelete: Cascade)
  service        Service? @relation(fields: [serviceId], references: [id])

  @@index([barberId, serviceId, validTo])
}

// =========================================================== CITAS
model Appointment {
  id            String    @id @default(cuid())
  code          String    @unique // código público, p.ej. MB-7K2X9Q
  barberId      String
  serviceId     String
  createdById   String? // null = web pública
  origin        String    @default("MANUAL") // PUBLIC | MANUAL
  status        String    @default("RESERVED") // RESERVED|CONFIRMED|IN_ATTENTION|COMPLETED|CANCELLED|NO_SHOW
  clientName    String
  clientPhone   String?
  clientEmail   String?
  startTime     DateTime
  endTime       DateTime
  priceSnapshot Int // COP vigentes al reservar (inmutable en la cita)
  discount      Int       @default(0) // COP, fijado al completar
  notes         String?
  cancelReason  String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  barber    User         @relation("AppointmentBarber", fields: [barberId], references: [id])
  service   Service      @relation(fields: [serviceId], references: [id])
  creator   User?        @relation("AppointmentCreator", fields: [createdById], references: [id])
  payments  Payment[]
  commission Commission?

  @@index([barberId, startTime])
  @@index([status, startTime])
  @@index([origin])
}

// =========================================================== PAGOS (separados de la cita)
model Payment {
  id              String   @id @default(cuid())
  appointmentId   String
  amount          Int // COP recibidos (bruto del pago)
  method          String // CASH | TRANSFER | CARD | OTHER
  status          String   @default("CONFIRMED") // CONFIRMED | PARTIALLY_REFUNDED | REFUNDED
  refundedAmount  Int      @default(0)
  externalRef     String?
  notes           String?
  refundReason    String?
  receivedAt      DateTime
  registeredById  String
  // Idempotencia: evita contabilizar dos veces el mismo pago
  clientRequestId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointment  Appointment @relation(fields: [appointmentId], references: [id])
  registeredBy User        @relation("PaymentRegistrar", fields: [registeredById], references: [id])

  @@index([appointmentId])
  @@index([receivedAt])
}

// =========================================================== COMISIONES (copia histórica)
model Commission {
  id              String   @id @default(cuid())
  appointmentId   String   @unique
  barberId        String
  status          String   @default("PENDING_PAYMENT") // PENDING_CONFIG | PENDING_PAYMENT | PAID
  configured      Boolean  @default(false) // ¿existía regla vigente al completar?
  commissionType  String? // PERCENT | FIXED | MIXED (copia)
  percent         Float?
  fixedAmount     Int?
  baseAmount      Int      @default(0) // venta neta (precio - descuento) al completar
  calculatedAmount Int     @default(0) // COP que gana el barbero
  manualSet       Boolean  @default(false) // definida manualmente por el propietario
  manualReason    String?
  snapshotJson    String // copia completa de las condiciones económicas del momento
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  barber           User              @relation("CommissionBarber", fields: [barberId], references: [id])
  appointment      Appointment       @relation(fields: [appointmentId], references: [id])
  settlementItems  SettlementItem[]

  @@index([barberId, status])
  @@index([createdAt])
}

// =========================================================== AJUSTES (anticipos / devoluciones / manual)
model CommissionAdjustment {
  id           String   @id @default(cuid())
  barberId     String
  type         String // ADVANCE | REFUND | MANUAL
  amount       Int // efecto con signo sobre la liquidación: anticipos y devoluciones negativos, MANUAL ±
  reason       String
  appointmentId String? // cita vinculada (opcional)
  appointmentCode String?
  status       String   @default("PENDING") // PENDING | SETTLED
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barber    User             @relation("AdjustmentBarber", fields: [barberId], references: [id])
  createdBy User             @relation("AdjustmentCreator", fields: [createdById], references: [id])
  items     SettlementItem[]

  @@index([barberId, status])
}

// =========================================================== LIQUIDACIONES
model Settlement {
  id               String    @id @default(cuid())
  code             String    @unique
  barberId         String
  status           String    @default("DRAFT") // DRAFT | APPROVED | PAID
  periodStart      DateTime?
  periodEnd        DateTime?
  notes            String?
  totalCommissions Int       @default(0)
  totalAdjustments Int       @default(0) // suma con signo de los ajustes incluidos
  totalAmount      Int       @default(0) // totalCommissions + totalAdjustments
  approvedById     String?
  approvedAt       DateTime?
  paidAt           DateTime?
  paymentMethod    String?
  externalRef      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  barber      User              @relation("SettlementBarber", fields: [barberId], references: [id])
  approvedBy  User?             @relation("SettlementApprover", fields: [approvedById], references: [id])
  items       SettlementItem[]

  @@index([barberId, status])
}

model SettlementItem {
  id           String   @id @default(cuid())
  settlementId String
  itemType     String // COMMISSION | ADVANCE | REFUND | MANUAL
  label        String
  amount       Int // efecto con signo sobre el total de la liquidación
  commissionId String?  @unique
  adjustmentId String?  @unique
  createdAt    DateTime @default(now())

  settlement  Settlement            @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  commission  Commission?           @relation(fields: [commissionId], references: [id])
  adjustment  CommissionAdjustment? @relation(fields: [adjustmentId], references: [id])
}

// =========================================================== GASTOS DEL PROPIETARIO
model Expense {
  id          String   @id @default(cuid())
  description String
  category    String // ALQUILER | INSUMOS | SERVICIOS | MANTENIMIENTO | NOMINA_EXTRA | OTROS
  amount      Int
  method      String?
  notes       String?
  spentAt     DateTime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("ExpenseCreator", fields: [createdById], references: [id])

  @@index([spentAt])
}

// =========================================================== AUDITORÍA
model AuditLog {
  id         String   @id @default(cuid())
  entity     String // APPOINTMENT | PAYMENT | COMMISSION_RULE | SETTLEMENT | ...
  entityId   String
  action     String // CREATE | UPDATE | STATUS_CHANGE | DELETE | APPROVE | PAY | REFUND | CONFIG ...
  beforeJson String?
  afterJson  String?
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

// =========================================================== NOTIFICACIONES INTERNAS
model Notification {
  id            String   @id @default(cuid())
  type          String // appointment.created | appointment.updated | payment.registered | ...
  title         String
  message       String
  userId        String
  read          Boolean  @default(false)
  metadataJson  String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// =========================================================== WHATSAPP (registro de envíos)
model WhatsappMessage {
  id                String    @id @default(cuid())
  dedupKey          String    @unique // evita notificaciones duplicadas por evento
  toPhone           String
  messageType       String // CONFIRMATION | REMINDER | STAFF_ALERT | CANCEL_NOTICE | TEST
  body              String
  status            String    @default("QUEUED") // QUEUED | SENT | FAILED | PENDING_CONFIG | SKIPPED
  providerMessageId String?
  error             String?
  attempts          Int       @default(0)
  appointmentId     String?
  appointmentCode   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentAt            DateTime?

  @@index([status])
}
